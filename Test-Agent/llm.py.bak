# CODEX INTENT ERKENNEN
# =========================
def is_codex_request(text: str) -> bool:
    """
    Prüft, ob der User möchte, dass Sunday ein Projekt / Code erstellt.
    """
    keywords = [
        "baue", "build", "create", "code", "program",
        "erstelle", "entwickle", "rebuild"
    ]
    return any(k in text.lower() for k in keywords)


# =========================
# CODEX ENGINE
# =========================
class CodexEngine:
    def __init__(self, progress_callback=None, stream_callback=None):
        """
        progress_callback(progress_text, percent)
        stream_callback(text_chunk)
        """
        self.progress_callback = progress_callback
        self.stream_callback = stream_callback
        self.project_path = "generated_projects"

    def build_project(self, intent: str):
        import os, time

        # Beispiel: Projekt-Ordner
        os.makedirs(self.project_path, exist_ok=True)
        modules = ["core", "ui", "database", "api", "tests"]
        total_files = len(modules) * 2
        count = 0

        for mod in modules:
            mod_path = os.path.join(self.project_path, mod)
            os.makedirs(mod_path, exist_ok=True)
            for fname in ["__init__.py", f"{mod}.py"]:
                file_path = os.path.join(mod_path, fname)
                with open(file_path, "w") as f:
                    content = f"# {mod} - generated by Sunday\n"
                    content += f"# Intent: {intent}\n"
                    f.write(content)
                    if self.stream_callback:
                        self.stream_callback(f"[{mod}/{fname}] written\n")
                count += 1
                if self.progress_callback:
                    self.progress_callback(f"Writing {mod}/{fname}", int(count/total_files*100))
                time.sleep(0.1)  # simuliert Schreibzeit

        if self.progress_callback:
            self.progress_callback("Project build complete", 100)


# =========================
# CODEX SELF TEST
# =========================
def codex_self_test(project_path):
    """
    Prüft alle Python-Dateien im Projekt auf Syntaxfehler.
    """
    import os
    errors = []

    for root, _, files in os.walk(project_path):
        for f in files:
            if f.endswith(".py"):
                path = os.path.join(root, f)
                try:
                    compile(open(path).read(), path, "exec")
                except Exception as e:
                    errors.append((path, str(e)))

    return errors

# =========================
# CODEX REPAIR LOOP
# =========================
def codex_repair_loop(intent, max_rounds=5):
    """
    Führt die CodexEngine aus, testet selbst, repariert automatisch.
    """
    for round in range(max_rounds):
        print(f"[CODEX] Round {round+1}/{max_rounds}")
        codex = CodexEngine(
            progress_callback=lambda msg, p: print(f"[CODEX {p}%] {msg}"),
            stream_callback=lambda text: print(text, end="")
        )
        codex.build_project(intent)

        errors = codex_self_test(codex.project_path)
        if not errors:
            print("[CODEX] All tests passed!")
            return
        print("[CODEX] Errors detected, repairing...")
        intent += f"\nFix these errors:\n{errors}"

    print("[CODEX] Finished with errors remaining.")



