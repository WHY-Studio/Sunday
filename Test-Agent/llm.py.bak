# =========================
# HELPER: LOAD/SAVE COMPRESSED KNOWLEDGE
# =========================
def load_knowledge():
    if not os.path.exists(KNOWLEDGE_PATH):
        return DEFAULT_KNOWLEDGE.copy()
    try:
        with gzip.open(KNOWLEDGE_PATH, "rt", encoding="utf-8") as f:
            data = json.load(f)
        # Sicherstellen, dass alle Keys vorhanden sind
        for k in DEFAULT_KNOWLEDGE:
            if k not in data:
                data[k] = DEFAULT_KNOWLEDGE[k]
        return data
    except Exception:
        return DEFAULT_KNOWLEDGE.copy()

def save_knowledge():
    with gzip.open(KNOWLEDGE_PATH, "wt", encoding="utf-8") as f:
        json.dump(knowledge, f, indent=2, ensure_ascii=False)

knowledge = load_knowledge()

